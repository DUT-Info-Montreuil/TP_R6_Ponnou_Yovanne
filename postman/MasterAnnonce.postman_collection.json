              "raw": "{\n  \"title\": \"Appartement T3 Paris 12\",\n  \"description\": \"Bel appartement lumineux, 65m2\",\n  \"adress\": \"12 rue de Lyon, 75012 Paris\",\n  \"mail\": \"contact@example.com\",\n  \"categoryId\": {{categoryId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/annonces",
              "host": ["{{baseUrl}}"],
              "path": ["annonces"]
            }
          }
        },
