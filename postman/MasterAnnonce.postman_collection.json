    {
      "name": "Security Tests",
      "item": [
        {
          "name": "Protected endpoint - No token (401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test\",\n  \"description\": \"Should fail\",\n  \"adress\": \"Somewhere\",\n  \"mail\": \"test@test.com\",\n  \"categoryId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/annonces",
              "host": ["{{baseUrl}}"],
              "path": ["annonces"]
            }
          }
        },
        {
          "name": "Protected endpoint - Invalid token (401)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "invalid-token-value", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
